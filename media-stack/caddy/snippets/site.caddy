import common.caddy

handle /jellyfin {
	redir /jellyfin/ 308
}
handle /jellyfin/* {
	reverse_proxy jellyfin:8096 {
		# Иначе по умолчанию Host = jellyfin:8096 — ломаются URL/редиректы за подпутём.
		header_up Host {http.request.host}
		flush_interval -1
		transport http {
			read_timeout 0
		}
	}
}

handle /prowlarr {
	redir /prowlarr/ 308
}
handle /prowlarr/* {
	reverse_proxy prowlarr:9696 {
		header_up Host {http.request.host}
	}
}

handle /aria2 {
	redir /aria2/ 308
}
handle /aria2/jsonrpc {
	uri strip_prefix /aria2
	reverse_proxy aria2:6800 {
		header_up Host {http.request.host}
	}
}
handle /aria2/json {
	uri strip_prefix /aria2
	rewrite * /jsonrpc
	reverse_proxy aria2:6800 {
		header_up Host {http.request.host}
	}
}
handle /aria2/* {
	uri strip_prefix /aria2
	reverse_proxy aria2-ui:6880 {
		header_up Host {http.request.host}
	}
}

handle {
	root * /srv
	file_server
}

# Опционально: HTTP Basic (браузер запросит логин до приложений).
# caddy hash-password --plaintext 'your-secret'
#
# basicauth {
#     admin $2a$14$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# }
