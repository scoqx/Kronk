# Прод: отдельные поддомены (TLS на каждом). Переменные — в env контейнера gateway (см. docker-compose.server.yml).
# Портал: статика; Prowlarr / Jellyfin / Flood — корень бэкенда (:9696 / :8096 / :3000).

{$PUBLIC_HOSTNAME} {
	import common.caddy
	# Чтобы браузер не показывал старый index.html после деплоя
	header Cache-Control "no-cache, must-revalidate"
	handle /api/rutracker/* {
		uri strip_prefix /api/rutracker
		reverse_proxy rutracker-api:8000
	}
	root * /srv
	file_server
}

{$PROWLARR_HOSTNAME} {
	import common.caddy
	reverse_proxy prowlarr:9696 {
		header_up Host {http.request.host}
	}
}

{$DELUGE_HOSTNAME} {
	import common.caddy
	reverse_proxy flood:3000 {
		header_up Host {http.request.host}
	}
}

{$JELLYFIN_HOSTNAME} {
	import common.caddy
	reverse_proxy jellyfin:8096 {
		header_up Host {http.request.host}
		flush_interval -1
		transport http {
			read_timeout 0
		}
	}
}
