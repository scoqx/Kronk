# Прод: отдельные поддомены (TLS на каждом). Переменные — в env контейнера gateway (см. docker-compose.server.yml).
# Портал: статика; MeTube / Prowlarr / Jellyfin / Flood — корень бэкенда (:8081 / :9696 / :8096 / :3000).

{$PUBLIC_HOSTNAME} {
	import common.caddy
	tls /etc/letsencrypt/live/super.scox.space/fullchain.pem /etc/letsencrypt/live/super.scox.space/privkey.pem
	# Чтобы браузер не показывал старый index.html после деплоя
	header Cache-Control "no-cache, must-revalidate"
	root * /srv
	file_server
}

{$METUBE_HOSTNAME} {
	import common.caddy
	tls /etc/letsencrypt/live/super.scox.space/fullchain.pem /etc/letsencrypt/live/super.scox.space/privkey.pem
	basicauth {
		{$METUBE_AUTH_USERNAME} {$METUBE_AUTH_PASSWORD_HASH}
	}
	reverse_proxy metube:8081 {
		header_up Host {http.request.host}
	}
}

{$PROWLARR_HOSTNAME} {
	import common.caddy
	tls /etc/letsencrypt/live/super.scox.space/fullchain.pem /etc/letsencrypt/live/super.scox.space/privkey.pem
	reverse_proxy prowlarr:9696 {
		header_up Host {http.request.host}
	}
}

{$DELUGE_HOSTNAME} {
	import common.caddy
	tls /etc/letsencrypt/live/super.scox.space/fullchain.pem /etc/letsencrypt/live/super.scox.space/privkey.pem
	reverse_proxy flood:3000 {
		header_up Host {http.request.host}
	}
}

{$JELLYFIN_HOSTNAME} {
	import common.caddy
	tls /etc/letsencrypt/live/super.scox.space/fullchain.pem /etc/letsencrypt/live/super.scox.space/privkey.pem
	reverse_proxy jellyfin:8096 {
		header_up Host {http.request.host}
		flush_interval -1
		transport http {
			read_timeout 0
		}
	}
}
