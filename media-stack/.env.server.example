# Пример для VPS: скопируйте в .env на сервере.
# Запуск: ./scripts/server-deploy.sh
#
# AriaNg Web UI: https://mmd.super.scox.space/
# Prowlarr → Download Client Aria2: хост aria2, порт 6800, secret из ARIA2_RPC_SECRET.

PUID=1000
PGID=1000
TZ=Europe/Moscow

PUBLIC_HOSTNAME=super.scox.space

PROWLARR_HOSTNAME=lft.super.scox.space
DELUGE_HOSTNAME=mmd.super.scox.space
JELLYFIN_HOSTNAME=wwv.super.scox.space

CADDY_PRIMARY_FILE=Caddyfile.server

EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443

# Порт на хосте для торрентов (в контейнере Aria2 слушает тот же порт).
ARIA2_PEER_PORT=6881

# RPC secret для Aria2/AriaNg/Prowlarr. На сервере задайте длинный случайный secret.
ARIA2_RPC_SECRET=change-me
