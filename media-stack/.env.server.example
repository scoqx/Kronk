# Пример для VPS: скопируйте в .env на сервере (или объедините с локальным шаблоном).
# Запуск: ./scripts/server-deploy.sh

PUID=1000
PGID=1000
TZ=Europe/Moscow

# Полное имя сайта (без https://). Caddy выпустит сертификат Let's Encrypt.
PUBLIC_HOSTNAME=media.example.com

# Главный Caddyfile с TLS по имени хоста.
CADDY_PRIMARY_FILE=Caddyfile.server

# На сервере обычно 80 и 443 на хосте.
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443

TRANSMISSION_USER=admin
TRANSMISSION_PASS=СМЕНИТЕ_НА_ДЛИННЫЙ_ПАРОЛЬ

TRANSMISSION_PEER_PORT=51413

# Необязательно: если пусто, compose подставит тот же домен, что PUBLIC_HOSTNAME.
TRANSMISSION_HOST_WHITELIST=
