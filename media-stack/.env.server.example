# Пример для VPS: скопируйте в .env на сервере (или объедините с локальным шаблоном).
# Запуск: ./scripts/server-deploy.sh

PUID=1000
PGID=1000
TZ=Europe/Moscow

# Портал (главная статическая страница).
PUBLIC_HOSTNAME=super.scox.space

# Сервисы на отдельных поддоменах (должны указывать A/AAAA на этот же сервер).
PROWLARR_HOSTNAME=lft.super.scox.space
TRANSMISSION_HOSTNAME=mmd.super.scox.space
JELLYFIN_HOSTNAME=wwv.super.scox.space

# Главный Caddyfile.
CADDY_PRIMARY_FILE=Caddyfile.server

# На сервере обычно 80 и 443 на хосте.
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443

TRANSMISSION_USER=admin
TRANSMISSION_PASS=СМЕНИТЕ_НА_ДЛИННЫЙ_ПАРОЛЬ

TRANSMISSION_PEER_PORT=51413

# Обязательно перечислите все веб-имена (портал + три поддомена), иначе Transmission отрежет RPC с «чужого» хоста.
TRANSMISSION_HOST_WHITELIST=super.scox.space,lft.super.scox.space,mmd.super.scox.space,wwv.super.scox.space
