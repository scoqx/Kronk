# Пример для VPS: скопируйте в .env на сервере.
# Запуск: ./scripts/server-deploy.sh
#
# Flood Web UI: https://mmd.super.scox.space/
# Flood/Prowlarr → qBittorrent: хост qbittorrent, порт 8080, username admin, пароль Web UI из логов qbittorrent.

PUID=1000
PGID=1000
TZ=Europe/Moscow

PUBLIC_HOSTNAME=super.scox.space

METUBE_HOSTNAME=mtt.super.scox.space
METUBE_AUTH_USERNAME=
METUBE_AUTH_PASSWORD=
METUBE_AUTH_PASSWORD_HASH=
PROWLARR_HOSTNAME=lft.super.scox.space
DELUGE_HOSTNAME=mmd.super.scox.space
JELLYFIN_HOSTNAME=wwv.super.scox.space

CADDY_PRIMARY_FILE=Caddyfile.server

EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443

# Порт на хосте для торрентов (в контейнере qBittorrent слушает тот же порт).
TORRENT_PEER_PORT=6881
