# Пример для VPS: скопируйте в .env на сервере.
# Запуск: ./scripts/server-deploy.sh
#
# Deluge Web UI (linuxserver): первый вход admin / deluge — смените в Preferences → Interface → Password.
# Prowlarr → Download Client Deluge: хост deluge-net, порт 58846, пароль из Preferences → Daemon.

PUID=1000
PGID=1000
TZ=Europe/Moscow

PUBLIC_HOSTNAME=super.scox.space

PROWLARR_HOSTNAME=lft.super.scox.space
DELUGE_HOSTNAME=mmd.super.scox.space
JELLYFIN_HOSTNAME=wwv.super.scox.space

CADDY_PRIMARY_FILE=Caddyfile.server

EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443

# Порт на хосте для торрентов (в контейнере Deluge слушает 6881 — при смене порта согласуйте в настройках Deluge).
DELUGE_PEER_PORT=6881

# Реальный Hysteria2/sing-box config.json храните вне репозитория на сервере.
# Пример: sudo install -d -m 700 /opt/kronk-secrets/sing-box
# SING_BOX_CONFIG_FILE=/opt/kronk-secrets/sing-box/config.json
