# Скопируйте в .env: cp .env.example .env

PUID=1000
PGID=1000
TZ=Europe/Moscow

# Transmission RPC (логин для веб UI и для Prowlarr как клиента)
TRANSMISSION_USER=admin
TRANSMISSION_PASS=changeme

# Единый HTTP-вход (хост:порт → контейнер :80). Локально часто 8080.
EDGE_HTTP_PORT=8080

# Какой файл слушает Caddy: локально Caddyfile; на сервере с TLS — Caddyfile.server + docker-compose.server.yml
CADDY_PRIMARY_FILE=Caddyfile

# Для прод-сценария с HTTPS (не обязательно локально): то же имя, что в DNS / сертификат.
PUBLIC_HOSTNAME=

# Порт торрентов (TCP/UDP на хост). Веб Transmission наружу не пробрасываем — только через gateway.
TRANSMISSION_PEER_PORT=51413

# Явный whitelist для Transmission (через запятую). Если пусто — используется PUBLIC_HOSTNAME из compose.
TRANSMISSION_HOST_WHITELIST=
TRANSMISSION_RPC_WHITELIST=
