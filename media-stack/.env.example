# Скопируйте в .env: cp .env.example .env

PUID=1000
PGID=1000
TZ=Europe/Moscow

# Единый HTTP-вход (хост:порт → контейнер :80). Локально часто 8080.
EDGE_HTTP_PORT=8080

# Какой файл слушает Caddy: локально Caddyfile; на сервере с TLS — Caddyfile.server + docker-compose.server.yml
CADDY_PRIMARY_FILE=Caddyfile

# Для прод-сценария с HTTPS: FQDN портала и поддоменов — см. .env.server.example.
PUBLIC_HOSTNAME=
METUBE_HOSTNAME=
METUBE_AUTH_USERNAME=
METUBE_AUTH_PASSWORD=
METUBE_AUTH_PASSWORD_HASH=
PROWLARR_HOSTNAME=
PRISMARR_HOSTNAME=
JELLYFIN_HOSTNAME=

# Порт входящих торрентов qBittorrent (TCP/UDP на хост → контейнер qBittorrent).
TORRENT_PEER_PORT=6881

# Локальный порт Prismarr UI.
PRISMARR_HTTP_PORT=7070
