# Скопируйте в .env: cp .env.example .env

PUID=1000
PGID=1000
TZ=Europe/Moscow

# Единый HTTP-вход (хост:порт → контейнер :80). Локально часто 8080.
EDGE_HTTP_PORT=8080

# Какой файл слушает Caddy: локально Caddyfile; на сервере с TLS — Caddyfile.server + docker-compose.server.yml
CADDY_PRIMARY_FILE=Caddyfile

# Для прод-сценария с HTTPS: FQDN портала и поддоменов — см. .env.server.example.
PUBLIC_HOSTNAME=
PROWLARR_HOSTNAME=
DELUGE_HOSTNAME=
JELLYFIN_HOSTNAME=

# Порт входящих торрентов Deluge (TCP/UDP на хост → контейнер deluge-net/Deluge 6881). Веб Deluge только через gateway.
DELUGE_PEER_PORT=6881

# sing-box (deluge-net): по умолчанию безопасный direct-конфиг из repo.
# На сервере для Hysteria2 храните реальный конфиг вне repo и укажите абсолютный путь:
# SING_BOX_CONFIG_FILE=/opt/kronk-secrets/sing-box/config.json

# Уровень лога deluged (опционально): none, error, warn, info, debug.
DELUGE_LOGLEVEL=info
