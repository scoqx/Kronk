{
  "log": {
    "level": "info"
  },
  "dns": {
    "servers": [
      {
        "tag": "remote",
        "address": "8.8.8.8",
        "strategy": "prefer_ipv4",
        "detour": "hy2-out"
      }
    ]
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": [
        "198.18.0.1/15"
      ],
      "auto_route": true,
      "stack": "system"
    }
  ],
  "outbounds": [
    {
      "type": "hysteria2",
      "tag": "hy2-out",
      "server": "YOUR_SERVER_HOST",
      "server_port": 50505,
      "password": "YOUR_HYSTERIA2_AUTH_PASSWORD",
      "tls": {
        "enabled": true,
        "server_name": "YOUR_SNI",
        "insecure": false,
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        }
      },
      "obfs": {
        "type": "salamander",
        "password": "YOUR_OBFS_PASSWORD"
      }
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "rules": [
      {
        "port": 53,
        "outbound": "direct"
      }
    ],
    "final": "hy2-out"
  }
}
